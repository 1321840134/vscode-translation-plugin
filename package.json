{
  "name": "vscode-translation-plugin",
  "displayName": "Translation",
  "description": "强大的翻译插件：多引擎翻译(微软/Google/DeepL/OpenAI/有道/百度/阿里)、翻译替换、翻译文档、单词本、翻译历史、多引擎语音朗读、自动取词",
  "version": "0.5.4",
  "publisher": "vscode-translation-plugin",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "translate",
    "translation",
    "翻译",
    "dictionary",
    "wordbook"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/1321840134/vscode-translation-plugin"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "translation.showDialog",
        "title": "翻译: 打开翻译对话框"
      },
      {
        "command": "translation.translate",
        "title": "翻译: 翻译(选中文本或光标处单词)"
      },
      {
        "command": "translation.translateAndReplace",
        "title": "翻译: 翻译并替换"
      },
      {
        "command": "translation.translateDocument",
        "title": "翻译: 翻译文档(在新窗口打开)"
      },
      {
        "command": "translation.switchEngine",
        "title": "翻译: 切换翻译引擎"
      },
      {
        "command": "translation.selectTargetLanguage",
        "title": "翻译: 选择目标语言"
      },
      {
        "command": "translation.selectSourceLanguage",
        "title": "翻译: 选择源语言"
      },
      {
        "command": "translation.showWordBook",
        "title": "翻译: 打开单词本"
      },
      {
        "command": "translation.showHistory",
        "title": "翻译: 打开翻译历史"
      },
      {
        "command": "translation.clearHistory",
        "title": "翻译: 清空翻译历史"
      },
      {
        "command": "translation.exportWordBook",
        "title": "翻译: 导出单词本"
      },
      {
        "command": "translation.wordOfTheDay",
        "title": "翻译: 每日一词"
      },
      {
        "command": "translation.translateDocComment",
        "title": "翻译: 翻译文档注释(悬浮处文档)"
      }
    ],
    "keybindings": [
      {
        "command": "translation.translate",
        "key": "ctrl+shift+y",
        "mac": "ctrl+cmd+u",
        "when": "editorTextFocus"
      },
      {
        "command": "translation.showDialog",
        "key": "ctrl+alt+o",
        "mac": "ctrl+cmd+i"
      },
      {
        "command": "translation.translateAndReplace",
        "key": "ctrl+alt+x",
        "mac": "ctrl+cmd+o",
        "when": "editorTextFocus"
      },
      {
        "command": "translation.switchEngine",
        "key": "ctrl+alt+s",
        "mac": "ctrl+cmd+y"
      },
      {
        "command": "translation.translateDocComment",
        "key": "ctrl+shift+q",
        "mac": "ctrl+cmd+j",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "translation.translate",
          "when": "editorTextFocus",
          "group": "translation@1"
        },
        {
          "command": "translation.translateAndReplace",
          "when": "editorTextFocus",
          "group": "translation@2"
        },
        {
          "command": "translation.translateDocument",
          "when": "editorTextFocus",
          "group": "translation@3"
        },
        {
          "command": "translation.translateDocComment",
          "when": "editorTextFocus",
          "group": "translation@4"
        }
      ]
    },
    "configuration": {
      "title": "Translation Plugin",
      "properties": {
        "translation.engine": {
          "type": "string",
          "enum": [
            "microsoft",
            "google",
            "deepl",
            "openai",
            "youdao",
            "baidu",
            "alibaba"
          ],
          "default": "microsoft",
          "description": "默认翻译引擎（微软翻译使用 Edge 公开端点，免费无需配置；Google 免费无需配置；其余需配置对应密钥）",
          "order": 1
        },
        "translation.sourceLanguage": {
          "type": "string",
          "enum": [
            "auto",
            "zh-CN",
            "zh-TW",
            "en",
            "ja",
            "ko",
            "fr",
            "de",
            "ru",
            "es",
            "pt",
            "it",
            "ar",
            "th",
            "vi",
            "id",
            "ms",
            "tr",
            "nl",
            "pl",
            "sv"
          ],
          "default": "auto",
          "description": "源语言（auto 为自动检测）",
          "order": 2
        },
        "translation.targetLanguage": {
          "type": "string",
          "enum": [
            "zh-CN",
            "zh-TW",
            "en",
            "ja",
            "ko",
            "fr",
            "de",
            "ru",
            "es",
            "pt",
            "it",
            "ar",
            "th",
            "vi",
            "id",
            "ms",
            "tr",
            "nl",
            "pl",
            "sv"
          ],
          "default": "zh-CN",
          "description": "目标语言",
          "order": 3
        },
        "translation.autoSwapTarget": {
          "type": "boolean",
          "default": true,
          "description": "当源语言与目标语言相同时，自动切换目标语言（中文↔英文），避免出现中译中/英译英",
          "order": 4
        },
        "translation.hover.enabled": {
          "type": "boolean",
          "default": false,
          "description": "鼠标悬浮自动翻译（默认关闭）。关闭后通过右键\"翻译\"命令触发词典悬浮：选中单词或光标处按右键翻译即弹出词典卡片",
          "order": 7
        },
        "translation.history.enabled": {
          "type": "boolean",
          "default": true,
          "description": "记录翻译历史",
          "order": 10
        },
        "translation.history.limit": {
          "type": "number",
          "default": 200,
          "description": "翻译历史最大条数",
          "order": 11
        },
        "translation.tts.enabled": {
          "type": "boolean",
          "default": true,
          "description": "启用语音朗读",
          "order": 13
        },
        "translation.tts.autoPlay": {
          "type": "boolean",
          "default": false,
          "description": "翻译完成后自动朗读原文",
          "order": 15
        },
        "translation.tts.service": {
          "type": "string",
          "enum": [
            "auto",
            "edge",
            "google",
            "openai"
          ],
          "default": "auto",
          "description": "语音合成服务：auto = Edge 优先、失败回退；edge/google/openai = 强制指定",
          "order": 14
        },
        "translation.tts.openaiModel": {
          "type": "string",
          "default": "gpt-4o-mini-tts",
          "description": "OpenAI TTS 模型（也可用 tts-1 等）",
          "order": 16
        },
        "translation.tts.openaiVoice": {
          "type": "string",
          "default": "alloy",
          "description": "OpenAI TTS 音色（alloy/echo/fable/onyx/nova/shimmer 等）",
          "order": 17
        },
        "translation.panel.position": {
          "type": "string",
          "enum": [
            "beside",
            "active",
            "one",
            "two"
          ],
          "default": "beside",
          "description": "翻译面板打开的位置",
          "order": 9
        },
        "translation.google.host": {
          "type": "string",
          "default": "translate.googleapis.com",
          "description": "Google 翻译接口域名（可修改为可用的镜像域名）",
          "order": 20
        },
        "translation.deepl.authKey": {
          "type": "string",
          "default": "",
          "description": "DeepL 身份验证密钥（DeepL API Free 的密钥以 :fx 结尾）",
          "order": 23
        },
        "translation.microsoft.subscriptionKey": {
          "type": "string",
          "default": "",
          "description": "可选：Azure Text Translation 订阅密钥（不填则自动使用 Edge 免费翻译端点）",
          "order": 21
        },
        "translation.microsoft.region": {
          "type": "string",
          "default": "",
          "description": "微软翻译服务区域，如 global、eastasia",
          "order": 22
        },
        "translation.openai.apiKey": {
          "type": "string",
          "default": "",
          "description": "OpenAI API Key",
          "order": 24
        },
        "translation.openai.model": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "OpenAI 翻译使用的模型",
          "order": 25
        },
        "translation.openai.apiBase": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "OpenAI API 地址（可改为兼容接口）",
          "order": 26
        },
        "translation.openai.systemPrompt": {
          "type": "string",
          "default": "",
          "description": "OpenAI 高级配置：自定义系统提示词，支持 {sourceLang}/{targetLang} 占位符，留空使用默认提示",
          "order": 27
        },
        "translation.openai.temperature": {
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 2,
          "description": "OpenAI 高级配置：采样温度（0-2，越低越稳定）",
          "order": 28
        },
        "translation.document.preserveSource": {
          "type": "boolean",
          "default": false,
          "description": "文档翻译时保留原文：输出\"原文/译文\"逐段对照",
          "order": 12
        },
        "translation.youdao.appKey": {
          "type": "string",
          "default": "",
          "description": "有道智云应用 ID",
          "order": 29
        },
        "translation.youdao.appSecret": {
          "type": "string",
          "default": "",
          "description": "有道智云应用密钥",
          "order": 30
        },
        "translation.baidu.appId": {
          "type": "string",
          "default": "",
          "description": "百度翻译 APP ID",
          "order": 31
        },
        "translation.baidu.appSecret": {
          "type": "string",
          "default": "",
          "description": "百度翻译密钥",
          "order": 32
        },
        "translation.alibaba.accessKeyId": {
          "type": "string",
          "default": "",
          "description": "阿里云 AccessKeyId（机器翻译通用版）",
          "order": 33
        },
        "translation.alibaba.accessKeySecret": {
          "type": "string",
          "default": "",
          "description": "阿里云 AccessKeySecret",
          "order": 34
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "tsc -p ./ && node --test test/*.test.js",
    "test:live": "node scripts/smoke-autoswap.js && node scripts/smoke-microsoft.js && node scripts/smoke-edge-tts.js",
    "icon": "node scripts/svg2png.mjs C:\\Users\\CL\\Desktop\\default.svg"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.4.0"
  }
}
